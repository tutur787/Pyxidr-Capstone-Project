.venv/
.git/
.DS_Store
__pycache__/
*.pyc
*.pyo
*.ipynb_checkpoints/

# Generated outputs (written at runtime, not needed in image)
data/*.csv
data/*.txt
data/*.png
r2_dist.png

# Secrets — never bake into image
gurobi.lic
*.lic
gcp-credentials.json
*-credentials.json
*.json
.env
.env.*

# Raw data — too large; mount as volume at runtime
data/

# Optimization/ holds heavy research notebooks/data not needed in any image.
# Exception: the backend image needs fabn_data_pipeline.py + fabn_finance.py
# (see backend/services/optimizer_service.py, which runs the pipeline via
# runpy against that exact path) — exclude everything else explicitly.
Optimization/*
!Optimization/fabn_data_pipeline.py
!Optimization/fabn_finance.py
Regulations/

# Editor / OS artifacts
.idea/
.vscode/
*.swp
