# Copy this file to .env and fill in values. Never commit .env.

# Gurobi WLS credentials — obtain from https://license.gurobi.com
GRB_WLSACCESSID=
GRB_WLSSECRET=
GRB_LICENSEID=

# GCP — credentials come from gcloud ADC (run: gcloud auth application-default login)
GCP_PROJECT_ID=your-gcp-project-id
GCS_INPUT_BUCKET=
GCS_OUTPUT_BUCKET=

# Agent — Hugging Face Inference API (Qwen2.5-7B-Instruct)
# Create a token at https://huggingface.co/settings/tokens
HF_TOKEN=
# Optional override (default: Qwen/Qwen2.5-7B-Instruct)
# HF_AGENT_MODEL=Qwen/Qwen2.5-7B-Instruct

# Dashboard backend only — Alpaca (news headlines, market quotes). Optional:
# unset degrades gracefully (backend/services/alpaca_service.py).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
